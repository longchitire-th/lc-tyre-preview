'use client';
import {useEffect,useState} from 'react';
import RotatingCards from './rotating-cards';
type Review={rating:number;text?:{text:string};originalText?:{text:string};authorAttribution:{displayName:string;uri?:string;photoUri?:string};relativePublishTimeDescription?:string;googleMapsUri?:string};
export default function GoogleReviews({lang}:{lang:'th'|'en'}){
 const [data,setData]=useState<{reviews:Review[];rating?:number;userRatingCount?:number;googleMapsUri?:string}|null>(null),[state,setState]=useState('loading');
 useEffect(()=>{const controller=new AbortController();setState('loading');fetch(`/api/google-reviews?lang=${lang}`,{signal:controller.signal}).then(async r=>{const json=await r.json() as {status?:string;reviews:Review[];rating?:number;userRatingCount?:number;googleMapsUri?:string};if(!r.ok||!json.reviews){setState(json.status==='not_configured'?'setup':'error');return}setData(json);setState('ready')}).catch(e=>{if(e.name!=='AbortError')setState('error')});return()=>controller.abort()},[lang]);
 const t=(th:string,en:string)=>lang==='th'?th:en;
 return <section className="v3-section v3-reviews" id="reviews"><h2>{t('เสียงจากลูกค้าของเรา','What our customers say')}</h2><p>Google Maps {data?.rating?` · ${data.rating}/5 · ${data.userRatingCount} ${t('รีวิว','reviews')}`:''}</p>{state==='ready'&&data?.reviews.length?<><RotatingCards lang={lang} label="Google reviews">{data.reviews.map((r,i)=><article className="v3-review-card" key={i}><a href={r.authorAttribution.uri||data.googleMapsUri} target="_blank" rel="noopener noreferrer">{r.authorAttribution.displayName}</a><p aria-label={`${r.rating} / 5`}>{'★'.repeat(r.rating)}{'☆'.repeat(5-r.rating)}</p><blockquote>{r.originalText?.text||r.text?.text||t('ให้คะแนนโดยไม่มีข้อความ','Rating without a written comment')}</blockquote><small>{r.relativePublishTimeDescription}</small><a href={r.googleMapsUri||data.googleMapsUri} target="_blank" rel="noopener noreferrer">{t('อ่านต้นฉบับบน Google Maps','Read on Google Maps')} ↗</a></article>)}</RotatingCards><p className="note">{t('รีวิวที่ Google API ส่งคืน เรียงตามความเกี่ยวข้อง ไม่ใช่รีวิวทั้งหมด','Reviews returned by Google API, ordered by relevance. Not all reviews.')}</p></>:<div className="v3-empty">{state==='loading'?t('กำลังตรวจการเชื่อมต่อ…','Checking connection…'):state==='setup'?t('เตรียมการ์ดรีวิวหมุนอัตโนมัติแล้ว รอเชื่อม Google Places API ของร้าน ไม่มีรีวิวสมมติ','Review carousel is ready. Connect the store’s Google Places API to display real reviews. No sample reviews.'):state==='ready'?t('ยังไม่มีรีวิวที่ API ส่งกลับมา','No reviews returned.'):t('โหลดรีวิวไม่ได้ชั่วคราว อ่านได้บน Google โดยตรง','Reviews are temporarily unavailable. Read them on Google.')}<a className="btn orange" href="https://share.google/QWSfJzMQSqOKv9VPh" target="_blank" rel="noopener noreferrer">{t('เปิดรีวิว Google','Open Google reviews')} ↗</a></div>}</section>;
}
